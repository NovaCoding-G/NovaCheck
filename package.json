{
  "name": "novacheck",
  "version": "0.4.0",
  "description": "Local-first CLI that finds hallucinated and typosquatted dependencies — in manifests, imports, and the install commands written in docs and agent instruction files — before you install them.",
  "type": "module",
  "license": "MIT",
  "author": "NovaCoding-G <novacodingg@gmail.com>",
  "homepage": "https://github.com/NovaCoding-G/NovaCheck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaCoding-G/NovaCheck.git"
  },
  "bugs": {
    "url": "https://github.com/NovaCoding-G/NovaCheck/issues",
    "email": "novacodingg@gmail.com"
  },
  "bin": {
    "novacheck": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prebuild": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun build src/cli.ts --target=node --packages=external --outdir=dist",
    "versioncheck": "bun run scripts/check-release-version.ts",
    "check": "bun run versioncheck && bun run typecheck && bun test && bun run build && bun run scripts/check-built-cli.ts",
    "prepack": "bun run build"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "keywords": [
    "slopsquatting",
    "hallucinated-packages",
    "ghost-dependencies",
    "typosquatting",
    "supply-chain-security",
    "dependency-confusion",
    "npm",
    "pypi",
    "ai-generated-code",
    "security",
    "code-scanning",
    "sarif",
    "secrets",
    "cli"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@secretlint/core": "^13.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@secretlint/source-creator": "^13.0.2",
    "@secretlint/types": "^13.0.2",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.11",
    "yaml": "^2.9.0"
  }
}
